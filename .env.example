# GHAZI Market Radar — Phase 5.1 hybrid unusual-flow configuration

# Legacy Phase 4 provider switch remains supported.
OPTIONS_PROVIDER=auto
MARKETDATA_TOKEN=

# Phase 5 option fallback: Tradier -> Finnhub -> Yahoo/yfinance.
# Tradier Sandbox is delayed by 15 minutes and does not provide provider Greeks.
TRADIER_TOKEN=
TRADIER_BASE_URL=https://sandbox.tradier.com
FINNHUB_API_KEY=
OPTIONS_PROVIDER_ORDER=tradier,finnhub,yahoo

# Phase 5 stock-bar fallback: Tiingo -> Finnhub -> Yahoo/yfinance.
TIINGO_API_KEY=
STOCK_PROVIDER_ORDER=tiingo,finnhub,yahoo

# Existing optional enrichment / legacy bar providers.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_OPTIONS_FEED=indicative
ALPACA_STOCK_FEED=iex
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# Legacy market_bars.py orders (kept for backward compatibility).
DAILY_PRICE_PROVIDER_ORDER=yahoo,tradier,alpaca,twelve_data,polygon,alpha_vantage
INTRADAY_PRICE_PROVIDER_ORDER=tradier,alpaca,twelve_data,polygon,yahoo,alpha_vantage

# SEC requires an identifiable application and contact email.
SEC_USER_AGENT=GHAZI Market Radar admin@example.com
SEC_REQUESTS_PER_SECOND=8
REQUEST_TIMEOUT_SECONDS=30
OPENFDA_API_KEY=

# Quantitative defaults.
RISK_FREE_RATE=0.043
FREE_SWING_MODE=true
MIN_DTE=14
MAX_DTE=60
MIN_OPTION_VOLUME=200
MIN_OPEN_INTEREST=100
MAX_SPREAD_PCT=0.15
MIN_ABS_DELTA=0.30
MAX_ABS_DELTA=0.60
MIN_OPTION_PRICE=0.25
MAX_OPTION_PRICE=30
MIN_DATA_QUALITY=0.50
MAX_LAST_TRADE_AGE_MINUTES=10080

# Phase 5.1 strict unusual-options-flow gates.
MIN_VOL_TO_OI_RATIO=1.50
HIGH_ACCUMULATION_RATIO=3.00
MIN_VOLUME_SPIKE_RATIO=2.00
# false allows Vol/OI >= 3.0 to confirm unusual flow when history is unavailable.
# true requires a measured volume spike >= 200% for every displayed contract.
FLOW_REQUIRE_VOLUME_SPIKE=false
FLOW_HISTORY_MAX_CONTRACTS=45
FLOW_HISTORY_WORKERS=3
FLOW_HISTORY_LOOKBACK_DAYS=14
FLOW_TOP_PER_SIDE=15

MIN_SCORE=65
ALERT_SCORE=76
ALERT_VOL_OI=2.0
MAX_WORKERS=4
MAX_UNIVERSE_SIZE=150
CALIBRATION_MINIMUM_SAMPLE=100
MODEL_VERSION=2026.07-phase5.1-flow

# Market regime.
VIX_RISK_OFF_THRESHOLD=25
VIX_RISK_ON_THRESHOLD=18

# Path-dependent paper tracking must cover the full maximum DTE.
OUTCOME_MAX_AGE_DAYS=60

# Persistent evidence files used by GitHub Actions.
DATABASE_PATH=data/live/alert_state.json
SIGNAL_JOURNAL_PATH=data/live/signals.jsonl
OUTCOME_PATH=data/live/outcomes.json
CALIBRATION_PATH=data/live/calibration.json
