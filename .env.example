# GHAZI Market Radar — Phase 6.2 evidence-class configuration
# Yahoo/YFinance is fallback-only and is intentionally last in every provider order.
# Tier A requires a primary/licensed market quote plus an independent evidence class.

OPTIONS_PROVIDER=auto
MARKETDATA_TOKEN=

# Options chain and OPRA-backed providers.
TRADIER_TOKEN=
TRADIER_BASE_URL=https://sandbox.tradier.com
FINNHUB_API_KEY=
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_OPTIONS_FEED=indicative
OPTIONS_PROVIDER_ORDER=tradier,marketdata,finnhub,yahoo

# Stock market providers. Yahoo remains the final emergency fallback.
TIINGO_API_KEY=
ALPACA_STOCK_FEED=iex
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
STOCK_PROVIDER_ORDER=tiingo,finnhub,tradier,alpaca,twelve_data,polygon,alpha_vantage,yahoo
DAILY_PRICE_PROVIDER_ORDER=tradier,alpaca,twelve_data,polygon,alpha_vantage,yahoo
INTRADAY_PRICE_PROVIDER_ORDER=tradier,alpaca,twelve_data,polygon,alpha_vantage,yahoo

# External intelligence and communities. Social data supports the thesis only;
# it cannot promote a candidate without independent market/official evidence.
BENZINGA_TOKEN=
X_BEARER_TOKEN=
X_WATCH_ACCOUNTS=unusual_whales,spotgamma,CheddarFlow,Barchart,Benzinga,Cboe,NasdaqExchange,NYSE
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=GHAZI-Market-Radar/6.2
REDDIT_COMMUNITIES=options,stocks,StockMarket,wallstreetbets,thetagang,investing,SecurityAnalysis
INTELLIGENCE_MAX_SYMBOLS=15
INTELLIGENCE_MAX_CONTRACTS=30

# Official and macro sources.
SEC_USER_AGENT=GHAZI Market Radar admin@example.com
SEC_REQUESTS_PER_SECOND=8
REQUEST_TIMEOUT_SECONDS=30
OPENFDA_API_KEY=
FRED_API_KEY=
# OCC Volume Query is official, free, and requires no key. It supplies aggregate
# CALL/PUT market context only; it is not a live quote or transaction-level flow.
OCC_FREE_ENABLED=true

# Swing defaults. SPX 0DTE uses its own independent realtime snapshot engine.
RISK_FREE_RATE=0.043
FREE_SWING_MODE=true
MIN_DTE=14
MAX_DTE=60
MIN_OPTION_VOLUME=200
MIN_OPEN_INTEREST=100
MAX_SPREAD_PCT=0.15
MIN_ABS_DELTA=0.30
MAX_ABS_DELTA=0.60
MIN_OPTION_PRICE=0.25
MAX_OPTION_PRICE=30
MIN_DATA_QUALITY=0.50
MAX_LAST_TRADE_AGE_MINUTES=10080

# Strict unusual-options-flow gates.
MIN_VOL_TO_OI_RATIO=1.50
HIGH_ACCUMULATION_RATIO=3.00
MIN_VOLUME_SPIKE_RATIO=2.00
FLOW_REQUIRE_VOLUME_SPIKE=false
FLOW_HISTORY_MAX_CONTRACTS=45
FLOW_HISTORY_WORKERS=3
FLOW_HISTORY_LOOKBACK_DAYS=14
FLOW_TOP_PER_SIDE=15

# BLACK BOX Omega Telegram alerts.
# Keep TELEGRAM_BOT_TOKEN in GitHub Actions Secrets, never commit a real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_EXPLOSION_RANK=80
TELEGRAM_MIN_EARLYNESS=75
TELEGRAM_MAX_DILUTION_RISK=60
TELEGRAM_MAX_RISK_PENALTY=38
TELEGRAM_MAX_ALERTS_PER_RUN=3

MIN_SCORE=65
ALERT_SCORE=76
ALERT_VOL_OI=2.0
MAX_WORKERS=4
MAX_UNIVERSE_SIZE=150
CALIBRATION_MINIMUM_SAMPLE=100
MODEL_VERSION=2026.07-phase6.2-evidence-tiers

VIX_RISK_OFF_THRESHOLD=25
VIX_RISK_ON_THRESHOLD=18
OUTCOME_MAX_AGE_DAYS=60

DATABASE_PATH=data/live/alert_state.json
SIGNAL_JOURNAL_PATH=data/live/signals.jsonl
OUTCOME_PATH=data/live/outcomes.json
CALIBRATION_PATH=data/live/calibration.json
