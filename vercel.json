{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "github": {
    "silent": true
  },
  "functions": {
    "api/sniper.py": {
      "maxDuration": 3
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/data/health.json"
    },
    {
      "source": "/data-status",
      "destination": "/data/data-status.json"
    },
    {
      "source": "/webhook/sniper",
      "destination": "/api/sniper"
    },
    {
      "source": "/webhook/tradingview",
      "destination": "/api/sniper"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-GHAZI-UI-BUILD",
          "value": "2026-08-25.sniper-webhook"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
